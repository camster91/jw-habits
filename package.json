{
  "name": "jw-news-pwa",
  "version": "2.0.0",
  "description": "Progressive Web App for tracking daily spiritual activities from JW.org",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "echo 'Start backend: npm run dev:backend' && echo 'Start frontend: npm run dev:frontend'",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "start": "npm run start:backend",
    "postinstall": "npm run install:all",
    "deploy": "npm run build && npm run start",
    "test": "echo 'Run tests'"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "keywords": [
    "jw",
    "pwa",
    "progressive-web-app",
    "spiritual-tracking",
    "bible-reading",
    "meetings",
    "daily-text"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camster91/JW-News"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
