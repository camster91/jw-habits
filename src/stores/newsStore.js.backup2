const splitItems = (allItems) => {
  const newsItems = allItems.filter((item) => item.type !== 'video');
  const videoItems = allItems.filter((item) => item.type === 'video');
  return { newsItems, videoItems };
};

const useNewsStore = create(
  persist(
    (set, get) => ({
      // State
      items: [],
      videoItems: [],
      readItems: {},
      savedItems: {},
      activeFilter: 'all',
      activeFeed: 'articles',
      isLoading: false,
      error: null,
      lastFetched: null,
      rssFeedUrl: 'https://www.jw.org/en/whats-new/rss/WhatsNewWebArticles/',

      // Actions
      setFilter: (filter) => set({ activeFilter: filter }),
      setActiveFeed: (feed) => set({ activeFeed: feed }),

      // In development, immediately use curated items
      fetchNews: async (forceRefresh = false) => {
        const state = get();

        // Check cache validity (1 hour)
        if (
          !forceRefresh &&
          state.lastFetched &&
          Date.now() - state.lastFetched < 60 * 60 * 1000 &&
          (state.items.length > 0 || state.videoItems.length > 0)
        ) {
          return; // Use cached data
        }

        set({ isLoading: true, error: null });

        // In development, immediately use curated items
        const allItems = getCuratedItems();
        const { newsItems, videoItems } = splitItems(allItems);

        set({
          items: newsItems,
          videoItems,
          lastFetched: Date.now(),
          isLoading: false,
          error: null,
        });
      },

      markAsRead: (itemId) =>
        set((state) => ({
          readItems: { ...state.readItems, [itemId]: true },
        })),

      markAllAsRead: () => {
        const state = get();
        const currentItems = state.activeFeed === 'videos' ? state.videoItems : state.items;
        const updates = {};
        currentItems.forEach((item) => {
          updates[item.id] = true;
        });
        set((state) => ({
          readItems: { ...state.readItems, ...updates },
        }));
      },

      toggleSaveItem: (itemId) =>
        set((state) => {
          const isSaved = state.savedItems[itemId];
          if (isSaved) {
            const { [itemId]: _, ...rest } = state.savedItems;
            return { savedItems: rest };
          } else {
            return { savedItems: { ...state.savedItems, [itemId]: true } };
          }
        }),

      isItemRead: (itemId) => {
        const state = get();
        return state.readItems[itemId] || false;
      },

      isItemSaved: (itemId) => {
        const state = get();
        return state.savedItems[itemId] || false;
      },

      getUnreadCount: () => {
        const state = get();
        const newsUnread = state.items.filter((item) => !state.readItems[item.id]).length;
        const videosUnread = state.videoItems.filter((item) => !state.readItems[item.id]).length;
        return newsUnread + videosUnread;
      },

      getNewsUnreadCount: () => {
        const state = get();
        return state.items.filter((item) => !state.readItems[item.id]).length;
      },

      getVideosUnreadCount: () => {
        const state = get();
        return state.videoItems.filter((item) => !state.readItems[item.id]).length;
      },

      getFilteredItems: () => {
        const state = get();
        const currentItems = state.activeFeed === 'videos' ? state.videoItems : state.items;

        if (state.activeFilter === 'all') {
          return currentItems;
        }
        if (state.activeFilter === 'saved') {
          return get().getSavedItems();
        }
        return currentItems.filter((item) => item.filterCategory === state.activeFilter);
      },

      getSavedItems: () => {
        const state = get();
        const allItems = [...state.items, ...state.videoItems];
        return allItems.filter((item) => state.savedItems[item.id]);
      },

      getSavedCount: () => {
        const state = get();
        return Object.keys(state.savedItems).length;
      },

      getUnreadItems: (count = 3) => {
        const state = get();
        const allItems = [...state.items, ...state.videoItems];
        return allItems
          .filter((item) => !state.readItems[item.id])
          .slice(0, count);
      },

      getLatestItems: (count = 3) => {
        const state = get();
        return state.items.slice(0, count);
      },
    }),
    {
      name: 'jw-news-store',
      partialize: (state) => ({
        readItems: state.readItems,
        savedItems: state.savedItems,
        activeFilter: state.activeFilter,
        activeFeed: state.activeFeed,
      }),
    }
  )
);

export default useNewsStore;